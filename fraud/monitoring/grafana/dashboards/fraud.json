{
 "uid": "fraud-stream",
 "title": "Phát hiện gian lận theo thời gian thực",
 "schemaVersion": 39,
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "refresh": "5s",
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Sự kiện / giây",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(fraud_events_total[1m])",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Độ trễ mỗi sự kiện p50 / p95 / p99",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum(rate(fraud_event_latency_seconds_bucket[1m])) by (le))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum(rate(fraud_event_latency_seconds_bucket[1m])) by (le))",
     "legendFormat": "p95"
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum(rate(fraud_event_latency_seconds_bucket[1m])) by (le))",
     "legendFormat": "p99"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Thời gian chấm điểm p95 (đặc trưng + mô hình)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum(rate(fraud_score_seconds_bucket[1m])) by (le))",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Cảnh báo / phút",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(fraud_alerts_total[1m]) * 60",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Tổng sự kiện",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 8,
    "x": 0,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "fraud_events_total",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Tổng cảnh báo",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 8,
    "x": 8,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "fraud_alerts_total",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 7,
   "type": "stat",
   "title": "Giao dịch có nhãn gian lận (khi phát lại)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 8,
    "x": 16,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "fraud_labelled_total",
     "legendFormat": ""
    }
   ]
  }
 ]
}