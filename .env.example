# Sao chép thành .env nếu cần đổi mặc định (docker compose tự đọc).

# Nạp mô hình thẳng từ MLflow dùng chung thay vì thư mục models/ (sau khi make register):
# CREDIT_MODEL_URI=models:/credit-risk@champion
# FRAUD_MODEL_URI=models:/fraud-lgbm@champion

# Cửa sổ đo drift (số sự kiện gần nhất) và tần suất tính lại
# CREDIT_DRIFT_WINDOW=1000
# CREDIT_DRIFT_EVERY=200
# FRAUD_DRIFT_WINDOW=2000
# FRAUD_DRIFT_EVERY=500

# Cảnh báo gian lận qua Telegram (không đặt thì chỉ ghi log)
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=

GRAFANA_PASSWORD=admin
