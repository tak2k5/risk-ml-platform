{
 "uid": "risk-overview",
 "title": "Rủi ro: tín dụng + gian lận",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "tags": [
  "risk"
 ],
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Drift dữ liệu (chung cho hai mô hình, PSI trên cửa sổ gần nhất so với dữ liệu train)",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Cảnh báo drift",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 6,
    "w": 6,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "ổn định",
         "color": "green"
        },
        "1": {
         "text": "DRIFT",
         "color": "red"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (model) (risk_drift_alert)",
     "legendFormat": "{{model}}"
    }
   ],
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name"
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "PSI của điểm số mô hình",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 6,
    "w": 9,
    "x": 6,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.1
       },
       {
        "color": "red",
        "value": 0.25
       }
      ]
     },
     "custom": {
      "thresholdsStyle": {
       "mode": "line"
      }
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "risk_score_psi",
     "legendFormat": "{{model}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "bargauge",
   "title": "Đặc trưng lệch nhiều nhất",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 12,
    "w": 9,
    "x": 15,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.1
       },
       {
        "color": "red",
        "value": 0.25
       }
      ]
     },
     "min": 0
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "topk(10, risk_feature_psi)",
     "legendFormat": "{{model}} / {{feature}}"
    }
   ],
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Số sự kiện trong cửa sổ đo",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 6,
    "w": 15,
    "x": 0,
    "y": 7
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "risk_drift_window_events",
     "legendFormat": "{{model}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "row",
   "title": "Tín dụng: API chấm điểm hồ sơ vay",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 13
   },
   "panels": []
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Hồ sơ / phút theo quyết định",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 14
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (decision) (rate(credit_decisions_total[1m])) * 60",
     "legendFormat": "{{decision}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Độ trễ /predict p50 / p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 14
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(credit_predict_seconds_bucket{endpoint=\"predict\"}[1m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(credit_predict_seconds_bucket{endpoint=\"predict\"}[1m])))",
     "legendFormat": "p95"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Xác suất vỡ nợ trung bình",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 14
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(credit_probability_default_sum[5m]) / rate(credit_probability_default_count[5m])",
     "legendFormat": "trung bình"
    }
   ]
  },
  {
   "id": 10,
   "type": "row",
   "title": "Gian lận: chấm điểm trên luồng (chi tiết: dashboard Fraud stream)",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 22
   },
   "panels": []
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Giao dịch / giây",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 23
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(fraud_events_total[1m])",
     "legendFormat": "giao dịch"
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Độ trễ mỗi giao dịch p95 / p99",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 23
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(fraud_event_latency_seconds_bucket[1m])))",
     "legendFormat": "p95"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(fraud_event_latency_seconds_bucket[1m])))",
     "legendFormat": "p99"
    }
   ]
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Cảnh báo / phút",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 23
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(fraud_alerts_total[1m]) * 60",
     "legendFormat": "cảnh báo"
    }
   ]
  }
 ]
}